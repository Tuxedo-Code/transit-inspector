{
  "name": "transit-inspector",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "DevTools panel that shows Transit API traffic decoded as EDN.",
  "license": "MIT",
  "author": "Eduard Kyvenko",
  "homepage": "https://github.com/Tuxedo-Code/transit-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tuxedo-Code/transit-inspector.git"
  },
  "bugs": "https://github.com/Tuxedo-Code/transit-inspector/issues",
  "scripts": {
    "dev": "vite --open /panel.html",
    "dev:ext": "vite build --watch",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && puppeteer browsers install chrome && vitest run --config vitest.e2e.config.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "package": "npm run build && rm -f transit-inspector-*.zip && cd dist && zip -qr ../transit-inspector-$npm_package_version.zip ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chrome": "^0.3.4",
    "@types/har-format": "^1.2.16",
    "@types/node": "^24.19.1",
    "@types/transit-js": "^0.8.3",
    "puppeteer": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@nextjournal/lang-clojure": "^1.0.0",
    "codemirror": "^6.0.2",
    "preact": "^11.0.0",
    "transit-js": "^0.8.874"
  }
}
